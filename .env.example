# Local-development convenience only. Copy to `.env` (gitignored) if you want the Vite dev
# middleware to call a model without pasting a key into the in-game ⚙ settings each time.
#
# The GAME NEEDS NONE OF THIS: it defaults to the offline template engine and works with zero
# config. In production the public deployment ships NO server keys — players bring their own
# (see README "AI generation"). These vars are NEVER deployed.

# Google AI Studio key for the built-in Gemini provider. Get one free: https://aistudio.google.com
# (Every other provider — OpenAI, Anthropic, Groq, OpenRouter, xAI, NVIDIA, Mistral, DeepSeek,
#  Custom — is bring-your-own-key entered in the in-game ⚙ settings, never an env var.)
GEMINI_API_KEY=

# Self-hosting only: set to 1 to let the deployed /api/generate function fund generation with the
# keys above. Leave UNSET (the default) for bring-your-own-key — a server key on a public,
# unauthenticated endpoint would be drained within hours.
# ALLOW_SERVER_KEYS=
